# Copy to .env and fill in. Never commit .env.

# Application
APP_ENV=development
API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]

# Database (docker compose exposes Postgres on 5434)
DATABASE_URL=postgresql+asyncpg://contentpulse:contentpulse@localhost:5434/contentpulse
TEST_DATABASE_URL=postgresql+asyncpg://contentpulse:contentpulse@localhost:5434/contentpulse_test

# Redis (docker compose exposes Redis on 6380). Optional locally: only Celery
# and the shared rate-limit counters use it; without Redis, limits use memory.
REDIS_URL=redis://localhost:6380/0

# Background jobs. inprocess (default) runs them inside the API, with nothing
# else to start. celery sends them to `celery worker` (plus `celery beat` for
# schedules); see the README section "Optional: run jobs on Celery locally".
TASK_BACKEND=inprocess
CELERY_BROKER_URL=                   # empty = REDIS_URL
JOB_RETRY_DELAYS=[30,120]            # seconds before retrying AI jobs after rate limits/outages

# Rate limits (429 RATE_LIMITED with Retry-After).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=auto              # auto (Redis if reachable, else memory) | redis | memory
API_RATE_LIMIT_PER_MINUTE=600        # per client IP, every /api request
TRUSTED_PROXY_COUNT=0                # proxies appending X-Forwarded-For; 1 behind a load balancer
COOKIE_SECURE=                       # empty = Secure only in production

# Authentication
# local    -> email/password, platform-issued JWT (default)
# supabase -> Supabase Auth: the web app signs in with Supabase, the API verifies
#             its tokens (asymmetric keys via JWKS; SUPABASE_JWT_SECRET only for
#             projects still on the legacy HS256 secret). Needs URL + anon key.
#             In Supabase > Authentication > URL Configuration, set Site URL to
#             FRONTEND_URL and add <FRONTEND_URL>/auth/callback as a redirect URL.
AUTH_PROVIDER=local
JWT_SECRET=  # required in production: python -c "import secrets; print(secrets.token_urlsafe(48))"
ACCESS_TOKEN_TTL_MINUTES=720
SUPABASE_URL=                        # https://<ref>.supabase.co
SUPABASE_ANON_KEY=                   # publishable key (sb_publishable_...): public, sent to browsers
SUPABASE_JWT_SECRET=                 # optional, legacy HS256 projects only

# Email (optional, local sign-in). With SMTP set, invitations are emailed and
# "Forgot password" sends a reset link. Without it, admins copy the invite
# link, and password reset asks the user to contact whoever runs ContentPulse.
# Any SMTP service works (Postmark, SendGrid, Amazon SES, Mailgun, Gmail app password).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls               # starttls (587) | ssl (465) | none (local relay only)
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=                           # e.g. ContentPulse <no-reply@yourdomain.com>
PASSWORD_RESET_TTL_MINUTES=30

# AI analysis (organization alignment). OPTIONAL: when unset, trends get a
# free rule-based relevance estimate (no AI reasoning or content angles).
#   gemini    -> Google Gemini, free tier: key from https://aistudio.google.com/apikey
#                (or set GEMINI_API_KEY). Defaults: gemini-3.8-flash, falls back
#                to gemini-3.5-flash on quota/capacity errors.
#   anthropic -> Claude: key from https://console.anthropic.com (or ANTHROPIC_API_KEY).
#                Defaults: claude-opus-5-5, falls back to claude-opus-5.
#   openai | groq | cerebras | openrouter -> OpenAI-compatible APIs (LLM_MODEL required).
#   none      -> always use the rule-based estimate, even if a key is set.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=                           # empty = provider default (recommended)
LLM_FALLBACK_MODEL=                  # empty = provider default; also covers retired models
LLM_EFFORT=medium                    # Claude only: low | medium | high | xhigh | max

# LLM gateway: every model call is rate limited, queued, retried and recorded
# (docs/llm-gateway.md). Defaults suit local use; nothing here is required.
# Per-model RPM/TPM/RPD/concurrency limits live in backend/llm_limits.json
# (free-tier figures: set yours). Override entries without editing the file:
#   LLM_LIMITS={"gemini/*": {"rpm": 1000, "rpd": 10000}}
LLM_RATE_LIMIT_SAFETY_FACTOR=0.8     # run at 80% of published limits
LLM_MAX_CONCURRENCY=3                # in-flight calls per model without a configured value
LLM_LIMITER_BACKEND=auto             # auto: share limits via Redis when reachable, else memory
LLM_MAX_RETRIES=2                    # per model, for 429 / 5xx, with backoff + Retry-After
LLM_QUEUE_TIMEOUT_INTERACTIVE=20     # seconds a waiting user's request may queue
LLM_QUEUE_TIMEOUT_BACKGROUND=600     # seconds a background job may queue
LLM_CACHE_TTL_SECONDS=86400          # reuse identical trend analyses; 0 = off
LLM_REQUEST_RETENTION_DAYS=90        # model-request history kept for the usage page; 0 = forever
# Cross-provider fallbacks ("provider/model"; needs that provider's key), and
# per-workflow chains (trend_alignment, content_strategy, post_generation, design_brief):
#   LLM_FALLBACKS=gemini/gemini-3.1-flash-lite, groq/openai/gpt-oss-120b, cerebras/qwen-3.8-27b
#   GROQ_API_KEY=
#   CEREBRAS_API_KEY=
#   ANTHROPIC_API_KEY=
#   OPENAI_API_KEY=
# Check the chain: cd backend && python -m app.ai.check [--probe]
#   LLM_ROUTES={"trend_alignment": ["gemini/gemini-3.5-flash", "groq/llama-4-scout"]}
# Application budgets, below provider quotas (empty = none):
#   LLM_DAILY_REQUEST_BUDGET=400
#   LLM_ORG_DAILY_REQUEST_BUDGET=150
#   LLM_WORKFLOW_DAILY_BUDGETS={"trend_alignment": 300}
METRICS_ENABLED=false                # Prometheus text at /health/metrics
ALIGNMENT_AI_BATCH_SIZE=15           # AI-analyzed trends per discovery run (cost guard)
ALIGNMENT_AUTO_ANALYZE=true          # analyze automatically after each discovery run
# Embeddings for semantic knowledge search. OPTIONAL: empty = keyword-only search.
#   gemini -> Google Gemini (key: EMBEDDING_API_KEY or GEMINI_API_KEY); default model
#             gemini-embedding-2. After switching, use Knowledge base › "Re-index now".
#   openai -> OpenAI or any OpenAI-compatible API via EMBEDDING_BASE_URL (1536 dims).
#   none   -> keyword-only even when a key is set (tests, E2E)
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=                     # empty = provider default
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1

# AI images on design tasks ("Generate image with AI"). OPTIONAL.
#   empty      -> the first provider set up: Kie AI, Cloudflare, Gemini, then OpenAI
#   kie        -> Kie AI, pay per image (seedream/5-flash-text-to-image is the cheapest;
#                 key from kie.ai). Images take ~25s.
#   cloudflare -> Cloudflare Workers AI: free daily allowance. Needs the account id and
#                 an API token with the "Workers AI" permission (dash.cloudflare.com).
#   gemini     -> needs billing on the key (the Gemini free tier allows 0 images)
#   openai     -> gpt-image-1;  none -> hide the button
IMAGE_PROVIDER=
IMAGE_MODEL=                         # empty = provider default. Kie: seedream/5-flash-text-to-image.
#                                      Cloudflare: @cf/black-forest-labs/flux-1-schnell (
#                                      ~173 neurons/image, ~57/day free, square images).
#                                      @cf/leonardo/lucid-origin: better text and sizes, but
#                                      ~2,800 neurons/image (~3/day on the free plan).
# Daily image cap per model (rpd in backend/llm_limits.json: Kie 50, Cloudflare 25,
# times the 0.8 safety factor). Change it without editing the file, e.g.
#   LLM_LIMITS={"kie/*": {"rpd": 20}}
KIE_AI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Website crawler
CRAWLER_DEFAULT_MAX_PAGES=50
CRAWLER_MAX_PAGES_LIMIT=300
# Dev/test only: lets the crawler fetch localhost/private IPs (e.g. the E2E
# fixture site). Never enable in production — it disables SSRF protection.
CRAWLER_ALLOW_PRIVATE_NETWORKS=false

# Creative storage (Sprint 7). OPTIONAL: without S3_BUCKET, uploads are stored
# in LOCAL_STORAGE_DIR on the API server via signed URLs (fine for dev).
# With S3_BUCKET, browsers upload straight to the bucket via presigned URLs;
# add a CORS rule allowing PUT/GET from FRONTEND_URL (see README).
# S3_ENDPOINT_URL makes it work with S3-compatible stores (Cloudflare R2,
# MinIO, Supabase Storage's S3 endpoint). Credentials may also come from the
# standard AWS chain (profile, IAM role).
S3_BUCKET=
S3_ENDPOINT_URL=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
LOCAL_STORAGE_DIR=storage
UPLOAD_MAX_MB=100
SIGNED_URL_TTL_SECONDS=900

# Trend sources. ALL OPTIONAL: an empty key only marks that source "Needs
# setup" in Trends › Sources; discovery runs with whatever is configured.
# Free, no key needed: Google Trends, Google News, Hacker News, RSS feeds.
TREND_SCHEDULER_ENABLED=true          # hourly / 6-hourly / daily-at-08:00 runs
TREND_SOURCE_TIMEOUT_SECONDS=45       # per source; a slow source is skipped

# Reddit works without keys via public RSS (limited, no vote counts).
# Free "script" app at https://www.reddit.com/prefs/apps unlocks the API.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# NewsAPI (https://newsapi.org) — free Developer plan is dev-only.
NEWS_API_KEY=
# GNews (https://gnews.io) — free plan: 100 requests/day.
GNEWS_API_KEY=
WORLD_NEWS_API_KEY=
NEWSDATA_API_KEY=
SERP_API_KEY=
APITUBE_NEWS_API_KEY=
# X API v2 recent search (paid plan). Either a bearer token, or key + secret.
X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=
# Instagram Graph API hashtag search (professional account + Meta app).
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_GRAPH_VERSION=v21.0
# LinkedIn has no public trends API; that source is listed but unavailable.

# Optional
FIRECRAWL_API_KEY=
